  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://shivang2828@github.com/shivang2828/hookrelay.git"
  },
