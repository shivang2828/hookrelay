{
  "name": "hookrelay",
  "version": "1.0.0",
  "type": "module",
  "description": "Reliable webhook delivery service: HMAC-signed payloads, idempotent ingestion, retries with exponential backoff and jitter, dead-letter queue and replay, and a transactional outbox so no event is ever lost.",
