# Copy this file to .env and fill in real values. .env is gitignored; this file is committed.
PORT=3000

# Must match the postgres service in docker-compose.yml
POSTGRES_USER=hookrelay
POSTGRES_PASSWORD=hookrelay
POSTGRES_DB=hookrelay
DATABASE_URL=postgres://hookrelay:hookrelay@localhost:5432/hookrelay

REDIS_URL=redis://localhost:6379
